# ─────────────────────────────────────────────────────────────────────────────
# CouchTomato API — keys and settings.  Copy to .env and paste your keys in.
# .env is git-ignored. Never commit real keys. After editing:
#     docker compose up -d --build     (re-reads .env)
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. TMDB (REQUIRED) — search, movie info, posters, IMDb-id lookup ─────────
# Free. Steps:
#   1. Sign up:          https://www.themoviedb.org/signup   (confirm the email)
#   2. Request a key:    https://www.themoviedb.org/settings/api  → "Create" → "Developer"
#      Type of use: Personal · App name: CouchTomato · URL: http://localhost
#      Summary: "Personal movie library manager" (any honest text is fine)
#   3. Copy the "API Key" (v3 auth, 32 hex chars) — NOT the long "Read Access Token".
TMDB_API_KEY=PASTE_TMDB_V3_API_KEY_HERE

# ── 2. OMDb (REQUIRED for ratings + IMDb data) — IMDb rating/votes, runtime ──
# Free tier: 1,000 requests/day (plenty — results are cached in Redis for 24 h).
#   1. Request:  https://www.omdbapi.com/apikey.aspx  → pick "FREE! (1,000 daily limit)"
#   2. Enter email, name, use: "personal movie library" → Submit
#   3. Open the email and CLICK THE ACTIVATION LINK — the key returns 401 until you do
#      (this is likely why CouchTomato's current OMDb key fails).
#   4. Test: https://www.omdbapi.com/?apikey=YOURKEY&i=tt0133093  → should show The Matrix
OMDB_API_KEY=PASTE_OMDB_KEY_HERE

# ── 3. Trakt (OPTIONAL — only if you use the Trakt notifier/automation) ──────
#   1. https://trakt.tv/oauth/applications/new  (sign in first)
#   2. Name: CouchTomato · Redirect URI: <PUBLIC_URL>/authorize/trakt/  (see PUBLIC_URL below)
#   3. Copy Client ID and Client Secret.
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# ── 4. put.io (OPTIONAL — only if you download via put.io) ───────────────────
#   https://app.put.io/oauth  → "Create new OAuth app", callback <PUBLIC_URL>/authorize/putio/
PUTIO_CLIENT_ID=
PUTIO_SECRET=

# ── 5. Twitter/X (OPTIONAL, not recommended — paid API now) ──────────────────
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

# ── Server settings ──────────────────────────────────────────────────────────
# Address CouchTomato uses to reach this API (used for OAuth redirect URLs).
PUBLIC_URL=http://localhost:3110
# Host port + bind address. Mac: keep 127.0.0.1. Pi5 serving the Pi4: API_BIND=0.0.0.0
API_PORT=3110
API_BIND=127.0.0.1
# Comma-separated client IPs allowed to call the API. '*' = anyone who can reach the port
# (OK while API_BIND=127.0.0.1). On the Pi5 set this to the Pi4's IP instead of '*'.
WHITELISTED_IPS=*
# Fallback suggestions for a brand-new library (IMDb ids).
SUGGESTED_MOVIES=tt0133093,tt0468569,tt1375666

# ── Leave blank — the original author's private services, gone since 2020 ───
MDB_PROXY_URL=
MDB_INFO_URL=
MDB_ETA_URL=
MDB_ISMOVIE_URL=
MOVIEINSIDER_URL=
VETA_URL=
